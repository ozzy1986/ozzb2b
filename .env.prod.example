OZZB2B_ENV=production

# The VPS already runs Postgres and Redis on localhost.
# Inside Docker, we reach the host via host.docker.internal.
OZZB2B_DATABASE_URL=postgresql+asyncpg://ozzb2b:CHANGE_ME@host.docker.internal:5432/ozzb2b
OZZB2B_REDIS_URL=redis://host.docker.internal:6379/3

OZZB2B_MEILISEARCH_URL=http://meilisearch:7700
OZZB2B_MEILISEARCH_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

MEILI_MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

OZZB2B_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
OZZB2B_JWT_ACCESS_TTL_SECONDS=900
OZZB2B_JWT_REFRESH_TTL_SECONDS=2592000
OZZB2B_AUTH_COOKIE_DOMAIN=.ozzb2b.com

OZZB2B_CORS_ORIGINS=https://ozzb2b.com,https://www.ozzb2b.com,https://api.ozzb2b.com

# Phase 3 matcher (Rust + gRPC). Safe to keep disabled; API falls back to
# un-re-ranked results on any matcher failure.
OZZB2B_MATCHER_ENABLED=false
OZZB2B_MATCHER_GRPC_ADDR=matcher:9090
OZZB2B_MATCHER_TIMEOUT_MS=150

# Phase 4 analytics pipeline (Redis Streams -> ClickHouse).
# API publishes events only when enabled; consumer drains from the same stream.
OZZB2B_EVENTS_ENABLED=false
OZZB2B_EVENTS_STREAM=ozzb2b:events:v1
OZZB2B_EVENTS_STREAM_MAXLEN=100000
OZZB2B_CLICKHOUSE_URL=http://clickhouse:8123
OZZB2B_CLICKHOUSE_USER=default
OZZB2B_CLICKHOUSE_PASSWORD=
OZZB2B_CLICKHOUSE_DATABASE=ozzb2b
OZZB2B_CLICKHOUSE_TIMEOUT_MS=2000

OZZB2B_LOG_LEVEL=INFO

NEXT_PUBLIC_OZZB2B_API_URL=https://api.ozzb2b.com

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Apache in front of the API is one proxy hop.
OZZB2B_TRUSTED_PROXY_COUNT=1

# Leads + outreach e-mail (Timeweb SMTP). Outreach drafts are only ever sent by hand.
OZZB2B_PUBLIC_SITE_URL=https://ozzb2b.com
OZZB2B_MAIL_ENABLED=false
OZZB2B_SMTP_HOST=smtp.timeweb.ru
OZZB2B_SMTP_PORT=465
OZZB2B_SMTP_USERNAME=noreply@ozzb2b.com
OZZB2B_SMTP_PASSWORD=CHANGE_ME
OZZB2B_MAIL_FROM=ozzb2b <noreply@ozzb2b.com>
OZZB2B_MAIL_REPLY_TO=
OZZB2B_ADMIN_NOTIFY_EMAIL=
